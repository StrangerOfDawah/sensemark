{
  "name": "sensemark-extension",
  "version": "1.5.0",
  "private": true,
  "description": "Tests and packaging checks for the Sensemark Chrome extension.",
  "scripts": {
    "check": "node scripts/validate-extension.js",
    "test": "node --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=90 --test-coverage-functions=95 --test-coverage-branches=75 --test-coverage-include=src/language-detection.js --test-coverage-include=src/selection-text.js --test-coverage-include=src/word-response.js --test-coverage-include=src/text-response.js --test-coverage-include=src/manual-translation.js --test-coverage-include=src/ui-scale.js --test-coverage-include=src/builtin-translator.js --test-coverage-include=src/card-theme.js --test-coverage-include=src/content/placement.js --test \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "design:approve": "node scripts/design-lock.js --approve",
    "design:status": "node scripts/design-lock.js",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.e2e.js\"",
    "safari:kit": "bash scripts/package-extension.sh && node scripts/build-safari-kit.js"
  },
  "devDependencies": {
    "jsdom": "29.1.1",
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=24"
  }
}
